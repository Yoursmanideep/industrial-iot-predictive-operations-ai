{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yoursmanideep/industrial-iot-predictive-operations-ai/blob/main/schemas/events/production_event.schema.json",
  "title": "Production Event",
  "description": "Canonical event contract for production-order, batch, output, pause, completion and production-loss events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "event_time",
    "ingestion_time",
    "source_system",
    "plant_id",
    "production_order_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[0-9a-fA-F-]{36}$"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ProductionOrderCreated",
        "ProductionOrderReleased",
        "ProductionStarted",
        "BatchStarted",
        "UnitProduced",
        "BatchCompleted",
        "ProductionPaused",
        "ProductionResumed",
        "ProductionCompleted",
        "ProductionLossRecorded"
      ]
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "ingestion_time": {
      "type": "string",
      "format": "date-time"
    },
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "plant_id": {
      "type": "string",
      "pattern": "^PLT-[A-Z]{3}-[0-9]{2}$"
    },
    "line_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}-L[0-9]{2}$"
    },
    "machine_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}-L[0-9]{2}-[A-Z]{3}[0-9]{2}$"
    },
    "production_order_id": {
      "type": "string",
      "pattern": "^PO-[0-9a-fA-F-]{36}$"
    },
    "batch_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^BAT-[0-9a-fA-F-]{36}$"
    },
    "product_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^PROD-[A-Z0-9_-]{3,30}$"
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^OP-[0-9a-fA-F-]{36}$"
    },
    "production_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "planned_quantity": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "actual_quantity": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "good_quantity": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "rejected_quantity": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "quantity_uom": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "unit",
        "kg",
        "litre",
        "meter",
        null
      ]
    },
    "planned_start_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "planned_end_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "actual_start_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "actual_end_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "pause_reason_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_-]{2,50}$"
    },
    "loss_reason_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_-]{2,50}$"
    },
    "loss_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DOWNTIME",
        "SLOWDOWN",
        "SCRAP",
        "QUALITY",
        "MATERIAL",
        "PLANNING",
        "OTHER",
        null
      ]
    },
    "loss_quantity": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "loss_duration_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "downtime_event_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^EVT-[0-9a-fA-F-]{36}$"
    },
    "machine_fault_event_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^EVT-[0-9a-fA-F-]{36}$"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "simulator_run_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^RUN-[0-9a-fA-F-]{36}$",
      "description": "Simulator run lineage identifier."
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SCN-[A-Z0-9_-]{3,50}$",
      "description": "Scenario catalog identifier when applicable."
    },
    "scenario_instance_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SCN-[0-9a-fA-F-]{36}$",
      "description": "Concrete scenario execution identifier when applicable."
    },
    "generated_at_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "UTC time at which the simulator generated the record."
    },
    "deterministic_seed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Seed used for deterministic generation."
    },
    "generation_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Monotonic generation order within simulator run."
    },
    "generator_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Simulator generator version."
    },
    "configuration_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Simulator configuration version."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ProductionOrderCreated"
          }
        }
      },
      "then": {
        "required": [
          "product_id",
          "planned_quantity",
          "quantity_uom",
          "planned_start_time",
          "planned_end_time"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ProductionOrderReleased"
          }
        }
      },
      "then": {
        "required": [
          "product_id",
          "planned_quantity",
          "quantity_uom"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ProductionStarted"
          }
        }
      },
      "then": {
        "required": [
          "product_id",
          "line_id",
          "actual_start_time"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "BatchStarted"
          }
        }
      },
      "then": {
        "required": [
          "batch_id",
          "product_id",
          "line_id",
          "actual_start_time"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "UnitProduced"
          }
        }
      },
      "then": {
        "required": [
          "batch_id",
          "product_id",
          "actual_quantity",
          "good_quantity",
          "rejected_quantity",
          "quantity_uom"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "BatchCompleted"
          }
        }
      },
      "then": {
        "required": [
          "batch_id",
          "actual_quantity",
          "good_quantity",
          "rejected_quantity",
          "quantity_uom",
          "actual_end_time"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ProductionPaused"
          }
        }
      },
      "then": {
        "required": [
          "line_id",
          "pause_reason_code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ProductionResumed"
          }
        }
      },
      "then": {
        "required": [
          "line_id",
          "actual_start_time"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ProductionCompleted"
          }
        }
      },
      "then": {
        "required": [
          "actual_quantity",
          "good_quantity",
          "rejected_quantity",
          "quantity_uom",
          "actual_end_time"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ProductionLossRecorded"
          }
        }
      },
      "then": {
        "required": [
          "loss_category",
          "loss_reason_code",
          "loss_quantity",
          "quantity_uom"
        ]
      }
    }
  ],
  "x-business-rules": [
    "good_quantity + rejected_quantity must not exceed actual_quantity.",
    "ProductionOrderCreated planned_quantity must be greater than zero.",
    "ProductionOrderCreated planned_end_time must be later than planned_start_time.",
    "A production event may omit machine_id when execution is defined at order or line level.",
    "downtime_event_id should reference the operational event that caused an attributable downtime loss.",
    "machine_fault_event_id may reference the corresponding MachineFaulted event when a machine fault directly caused production impact."
  ]
}
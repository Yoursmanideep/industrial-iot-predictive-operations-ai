table Production
    measure 'Actual Units' = SUM(Production[actual_quantity])
        formatString: #,##0
    measure 'Good Units' = SUM(Production[good_quantity])
        formatString: #,##0
    measure 'Rejected Units' = SUM(Production[rejected_quantity])
        formatString: #,##0
    measure 'Production Yield %' = DIVIDE([Good Units], [Actual Units])
        formatString: 0.0%
    column event_id
        dataType: string
        isHidden
        summarizeBy: none
        sourceColumn: event_id
    column date_sk
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: date_sk
    column shift_sk
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: shift_sk
    column plant_sk
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: plant_sk
    column line_sk
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: line_sk
    column machine_sk
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: machine_sk
    column product_sk
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: product_sk
    column production_order_id
        dataType: string
        summarizeBy: none
        sourceColumn: production_order_id
    column batch_id
        dataType: string
        summarizeBy: none
        sourceColumn: batch_id
    column event_type
        dataType: string
        summarizeBy: none
        sourceColumn: event_type
    column actual_quantity
        dataType: decimal
        summarizeBy: sum
        sourceColumn: actual_quantity
    column good_quantity
        dataType: decimal
        summarizeBy: sum
        sourceColumn: good_quantity
    column rejected_quantity
        dataType: decimal
        summarizeBy: sum
        sourceColumn: rejected_quantity
    column loss_quantity
        dataType: decimal
        summarizeBy: sum
        sourceColumn: loss_quantity
    column event_time_utc
        dataType: dateTime
        summarizeBy: none
        sourceColumn: event_time_utc
    partition Production = entity
        mode: directLake
        source
            entityName: fact_production_event
            schemaName: gold
            expressionSource: DL_Warehouse
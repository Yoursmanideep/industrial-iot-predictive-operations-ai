{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Yoursmanideep/industrial-iot-predictive-operations-ai/blob/main/simulator/schemas/production_context.schema.json","title":"Simulator Production Context","type":"object","additionalProperties":false,"required":["event_time_utc","plant_id","line_id","shift_id","ambient_temperature_c","utility_power_factor","workload"],"properties":{"event_time_utc":{"type":"string","format":"date-time"},"plant_id":{"type":"string","pattern":"^PLT-[A-Z]{3}-[0-9]{2}$"},"line_id":{"type":"string","pattern":"^[A-Z]{3}-L[0-9]{2}$"},"shift_id":{"type":"string","enum":["SH1","SH2","SH3"]},"product_id":{"type":["string","null"]},"product_cycle_time_seconds":{"type":["number","null"],"minimum":0},"ambient_temperature_c":{"type":"number"},"utility_power_factor":{"type":"number","minimum":0,"maximum":1.1},"workload":{"type":"object","additionalProperties":false,"required":["workload_factor","line_utilization","effective_capacity_units_min","changeover_penalty","age_penalty","health_penalty"],"properties":{"workload_factor":{"type":"number","minimum":0,"maximum":1.2},"line_utilization":{"type":"number","minimum":0,"maximum":1},"effective_capacity_units_min":{"type":"number","minimum":0},"changeover_penalty":{"type":"number","minimum":0,"maximum":1},"age_penalty":{"type":"number","minimum":0,"maximum":1},"health_penalty":{"type":"number","minimum":0,"maximum":1}}}}}
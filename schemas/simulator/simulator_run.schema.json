{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yoursmanideep/industrial-iot-predictive-operations-ai/blob/main/schemas/simulator/simulator_run.schema.json",
  "title": "Simulator Run",
  "description": "Metadata contract for one deterministic industrial simulation run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "simulator_run_id",
    "run_mode",
    "generator_version",
    "configuration_version",
    "deterministic_seed",
    "simulation_start_time",
    "simulation_end_time"
  ],
  "properties": {
    "simulator_run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9a-fA-F-]{36}$"
    },
    "run_mode": {
      "type": "string",
      "enum": ["BOOTSTRAP", "BACKFILL", "LIVE", "REPLAY"]
    },
    "source_run_id": {
      "type": ["string", "null"],
      "pattern": "^RUN-[0-9a-fA-F-]{36}$"
    },
    "generator_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "configuration_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "deterministic_seed": {
      "type": "integer",
      "minimum": 0
    },
    "simulation_start_time": {
      "type": "string",
      "format": "date-time"
    },
    "simulation_end_time": {
      "type": "string",
      "format": "date-time"
    },
    "created_at_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "type": ["string", "null"],
      "enum": ["PLANNED", "RUNNING", "COMPLETED", "FAILED", "CANCELLED", "REPLAYED", null]
    },
    "generation_statistics": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "notes": {
      "type": ["string", "null"]
    }
  }
}
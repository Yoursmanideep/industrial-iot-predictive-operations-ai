    column line_id
        dataType: string
        isDefaultLabel
        summarizeBy: none
        sourceColumn: line_id
    column line_name
        dataType: string
        summarizeBy: none
        sourceColumn: line_name
    column line_type
        dataType: string
        summarizeBy: none
        sourceColumn: line_type
    column plant_sk
        dataType: int64
        isHidden
        summarizeBy: none

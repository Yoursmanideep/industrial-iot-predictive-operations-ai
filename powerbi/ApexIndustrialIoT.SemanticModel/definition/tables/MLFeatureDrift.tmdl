table MLFeatureDrift
    column model_name
        dataType: string
        summarizeBy: none
        sourceColumn: model_name
    column model_version
        dataType: string
        summarizeBy: none
        sourceColumn: model_version
    column feature_name
        dataType: string
        summarizeBy: none
        sourceColumn: feature_name
    column baseline_row_count
        dataType: int64
        summarizeBy: sum
        sourceColumn: baseline_row_count
    column recent_row_count
        dataType: int64
        summarizeBy: sum
        sourceColumn: recent_row_count
    column psi_value
        dataType: decimal
        summarizeBy: average
        sourceColumn: psi_value
    column severity
        dataType: string
        summarizeBy: none
        sourceColumn: severity
    column feature_version
        dataType: string
        summarizeBy: none
        sourceColumn: feature_version
    column created_at_utc
        dataType: dateTime
        summarizeBy: none
        sourceColumn: created_at_utc
    partition MLFeatureDrift = entity
        mode: directLake
        source
            entityName: fact_ml_feature_drift
            schemaName: gold
            expressionSource: DL_Warehouse

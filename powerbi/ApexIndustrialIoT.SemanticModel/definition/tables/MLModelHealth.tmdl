table MLModelHealth
    measure 'Model Health Breaches' = CALCULATE(COUNTROWS(MLModelHealth), MLModelHealth[status] = "BREACH")
        formatString: #,##0
    column model_name
        dataType: string
        summarizeBy: none
        sourceColumn: model_name
    column model_version
        dataType: string
        summarizeBy: none
        sourceColumn: model_version
    column monitor_window_start_utc
        dataType: dateTime
        summarizeBy: none
        sourceColumn: monitor_window_start_utc
    column monitor_window_end_utc
        dataType: dateTime
        summarizeBy: none
        sourceColumn: monitor_window_end_utc
    column metric_name
        dataType: string
        summarizeBy: none
        sourceColumn: metric_name
    column metric_value
        dataType: decimal
        summarizeBy: average
        sourceColumn: metric_value
    column threshold_value
        dataType: decimal
        summarizeBy: average
        sourceColumn: threshold_value
    column status
        dataType: string
        summarizeBy: none
        sourceColumn: status
    column action
        dataType: string
        summarizeBy: none
        sourceColumn: action
    column feature_version
        dataType: string
        summarizeBy: none
        sourceColumn: feature_version
    column created_at_utc
        dataType: dateTime
        summarizeBy: none
        sourceColumn: created_at_utc
    partition MLModelHealth = entity
        mode: directLake
        source
            entityName: fact_ml_model_monitoring
            schemaName: gold
            expressionSource: DL_Warehouse

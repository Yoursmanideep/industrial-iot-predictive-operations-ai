{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Yoursmanideep/industrial-iot-predictive-operations-ai/blob/main/simulator/schemas/production_batch.schema.json","title":"Simulator Production Batch State","type":"object","additionalProperties":false,"required":["batch_id","production_order_id","plant_id","line_id","product_id","planned_quantity","batch_sequence","status","actual_quantity","good_quantity","rejected_quantity"],"properties":{"batch_id":{"type":"string","pattern":"^BAT-[0-9a-fA-F-]{36}$"},"production_order_id":{"type":"string","pattern":"^PO-[0-9a-fA-F-]{36}$"},"plant_id":{"type":"string","pattern":"^PLT-[A-Z]{3}-[0-9]{2}$"},"line_id":{"type":"string","pattern":"^[A-Z]{3}-L[0-9]{2}$"},"product_id":{"type":"string","pattern":"^PROD-[A-Z0-9_-]{3,30}$"},"planned_quantity":{"type":"integer","minimum":1},"batch_sequence":{"type":"integer","minimum":1,"maximum":8},"status":{"type":"string","enum":["CREATED","STARTED","IN_PROGRESS","PAUSED","COMPLETED","CANCELLED"]},"actual_quantity":{"type":"number","minimum":0},"good_quantity":{"type":"number","minimum":0},"rejected_quantity":{"type":"number","minimum":0},"actual_start_time":{"type":["string","null"],"format":"date-time"},"actual_end_time":{"type":["string","null"],"format":"date-time"}},"x-business-rule":"good_quantity + rejected_quantity must not exceed actual_quantity."}
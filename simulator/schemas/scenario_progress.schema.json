{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Yoursmanideep/industrial-iot-predictive-operations-ai/blob/main/simulator/schemas/scenario_progress.schema.json","title":"Simulator Scenario Progress","type":"object","additionalProperties":false,"required":["scenario_instance_id","stage","status","severity","normalized_progress","production_multiplier","quality_multiplier","terminal"],"properties":{"scenario_instance_id":{"type":"string","pattern":"^[0-9a-fA-F-]{36}$"},"stage":{"type":"string","enum":["BASELINE","EARLY_DEGRADATION","ANOMALY","CRITICAL","FAILURE","MAINTENANCE","RECOVERY"]},"status":{"type":"string","enum":["PLANNED","ACTIVE","INTERRUPTED","FAILED","RESOLVED","AVOIDED"]},"severity":{"type":"number","minimum":0,"maximum":1},"normalized_progress":{"type":"number","minimum":0,"maximum":1},"production_multiplier":{"type":"number","minimum":0,"maximum":1},"quality_multiplier":{"type":"number","minimum":0,"maximum":1},"terminal":{"type":"boolean"}}}
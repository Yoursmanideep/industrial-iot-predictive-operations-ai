{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yoursmanideep/industrial-iot-predictive-operations-ai/blob/main/schemas/simulator/scenario_instance.schema.json",
  "title": "Scenario Instance",
  "description": "Contract for one executable degradation or failure scenario assigned to a machine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_instance_id",
    "simulator_run_id",
    "scenario_id",
    "machine_id",
    "failure_mode_code",
    "started_at",
    "planned_end_at",
    "scenario_stage",
    "status",
    "generated_at_utc",
    "deterministic_seed",
    "generation_sequence",
    "generator_version"
  ],
  "properties": {
    "scenario_instance_id": {
      "type": "string",
      "pattern": "^SCN-[0-9a-fA-F-]{36}$"
    },
    "simulator_run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9a-fA-F-]{36}$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^SCN-[A-Z0-9_-]{3,50}$"
    },
    "machine_id": {
      "type": "string",
      "pattern": "^[A-Z]{3}-L[0-9]{2}-[A-Z]{3}[0-9]{2}$"
    },
    "failure_mode_code": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{2,50}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "planned_end_at": {
      "type": "string",
      "format": "date-time"
    },
    "actual_end_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "scenario_stage": {
      "type": "string",
      "enum": [
        "BASELINE",
        "EARLY_DEGRADATION",
        "ANOMALY",
        "CRITICAL",
        "FAILURE",
        "MAINTENANCE",
        "RECOVERY"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PLANNED",
        "ACTIVE",
        "INTERRUPTED",
        "FAILED",
        "RESOLVED",
        "AVOIDED"
      ]
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "SCHEDULED",
        "HEALTH_DRIVEN",
        "WORKLOAD_DRIVEN",
        "EXTERNAL_CONDITION",
        "PREDICTIVE_INTERVENTION"
      ]
    },
    "intervention_event_id": {
      "type": ["string", "null"],
      "pattern": "^EVT-[0-9a-fA-F-]{36}$"
    },
    "failure_event_id": {
      "type": ["string", "null"],
      "pattern": "^EVT-[0-9a-fA-F-]{36}$"
    },
    "correlation_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "deterministic_seed": {
      "type": "integer",
      "minimum": 0
    },
    "generation_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "generator_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
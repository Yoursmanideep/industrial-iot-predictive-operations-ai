{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yoursmanideep/industrial-iot-predictive-operations-ai/blob/main/schemas/ml/predictive_maintenance_features.schema.json",
  "title": "Predictive Maintenance Feature Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "feature_version",
    "feature_time_utc",
    "plant_id",
    "line_id",
    "machine_id",
    "machine_type_code",
    "shift_code",
    "temperature_c",
    "vibration_mm_s",
    "pressure_bar",
    "power_kw",
    "cycle_time_s",
    "throughput_unit_min",
    "quality_score_pct",
    "position_error_mm",
    "motor_current_a",
    "torque_nm",
    "alarm_count_15m",
    "alarm_count_60m",
    "fault_count_24h",
    "communication_loss_count_60m",
    "line_actual_quantity_15m",
    "line_loss_quantity_15m",
    "line_actual_quantity_60m",
    "line_loss_quantity_60m",
    "utilization_proxy_15m"
  ],
  "properties": {
    "feature_id": {"type": "string", "minLength": 64, "maxLength": 64},
    "feature_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "feature_time_utc": {"type": "string", "format": "date-time"},
    "plant_id": {"type": "string", "pattern": "^PLT-[A-Z]{3}-[0-9]{2}$"},
    "line_id": {"type": "string", "pattern": "^[A-Z]{3}-L[0-9]{2}$"},
    "machine_id": {"type": "string", "pattern": "^[A-Z]{3}-L[0-9]{2}-[A-Z]{3}[0-9]{2}$"},
    "machine_type": {"type": "string"},
    "machine_type_code": {"type": "integer", "minimum": 1, "maximum": 9},
    "shift_code": {"type": "integer", "enum": [1, 2, 3]},
    "hour_sin": {"type": ["number", "null"], "minimum": -1.0, "maximum": 1.0},
    "hour_cos": {"type": ["number", "null"], "minimum": -1.0, "maximum": 1.0},
    "temperature_c": {"type": ["number", "null"]},
    "vibration_mm_s": {"type": ["number", "null"]},
    "pressure_bar": {"type": ["number", "null"]},
    "power_kw": {"type": ["number", "null"]},
    "cycle_time_s": {"type": ["number", "null"]},
    "throughput_unit_min": {"type": ["number", "null"]},
    "quality_score_pct": {"type": ["number", "null"]},
    "position_error_mm": {"type": ["number", "null"]},
    "motor_current_a": {"type": ["number", "null"]},
    "torque_nm": {"type": ["number", "null"]},
    "temperature_c_mean_15m": {"type": ["number", "null"]},
    "temperature_c_std_15m": {"type": ["number", "null"]},
    "temperature_c_delta_15m": {"type": ["number", "null"]},
    "temperature_c_mean_60m": {"type": ["number", "null"]},
    "temperature_c_std_60m": {"type": ["number", "null"]},
    "temperature_c_delta_60m": {"type": ["number", "null"]},
    "vibration_mm_s_mean_15m": {"type": ["number", "null"]},
    "vibration_mm_s_std_15m": {"type": ["number", "null"]},
    "vibration_mm_s_delta_15m": {"type": ["number", "null"]},
    "vibration_mm_s_mean_60m": {"type": ["number", "null"]},
    "vibration_mm_s_std_60m": {"type": ["number", "null"]},
    "vibration_mm_s_delta_60m": {"type": ["number", "null"]},
    "pressure_bar_mean_15m": {"type": ["number", "null"]},
    "pressure_bar_std_15m": {"type": ["number", "null"]},
    "pressure_bar_delta_15m": {"type": ["number", "null"]},
    "pressure_bar_mean_60m": {"type": ["number", "null"]},
    "pressure_bar_std_60m": {"type": ["number", "null"]},
    "pressure_bar_delta_60m": {"type": ["number", "null"]},
    "power_kw_mean_15m": {"type": ["number", "null"]},
    "power_kw_std_15m": {"type": ["number", "null"]},
    "power_kw_delta_15m": {"type": ["number", "null"]},
    "power_kw_mean_60m": {"type": ["number", "null"]},
    "power_kw_std_60m": {"type": ["number", "null"]},
    "power_kw_delta_60m": {"type": ["number", "null"]},
    "machine_age_days": {"type": ["number", "null"], "minimum": 0},
    "alarm_count_15m": {"type": "integer", "minimum": 0},
    "alarm_count_60m": {"type": "integer", "minimum": 0},
    "fault_count_24h": {"type": "integer", "minimum": 0},
    "communication_loss_count_60m": {"type": "integer", "minimum": 0},
    "line_actual_quantity_15m": {"type": "number", "minimum": 0},
    "line_loss_quantity_15m": {"type": "number", "minimum": 0},
    "line_actual_quantity_60m": {"type": "number", "minimum": 0},
    "line_loss_quantity_60m": {"type": "number", "minimum": 0},
    "utilization_proxy_15m": {"type": "number", "minimum": 0, "maximum": 1},
    "operating_state": {"type": "string"},
    "source_window_end_utc": {"type": "string", "format": "date-time"}
  }
}

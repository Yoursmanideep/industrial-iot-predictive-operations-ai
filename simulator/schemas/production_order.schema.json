{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Yoursmanideep/industrial-iot-predictive-operations-ai/blob/main/simulator/schemas/production_order.schema.json","title":"Simulator Production Order State","type":"object","additionalProperties":false,"required":["production_order_id","plant_id","line_id","product_id","planned_quantity","quantity_uom","planned_start_time","planned_end_time","status","actual_quantity","good_quantity","rejected_quantity"],"properties":{"production_order_id":{"type":"string","pattern":"^PO-[0-9a-fA-F-]{36}$"},"plant_id":{"type":"string","pattern":"^PLT-[A-Z]{3}-[0-9]{2}$"},"line_id":{"type":"string","pattern":"^[A-Z]{3}-L[0-9]{2}$"},"product_id":{"type":"string","pattern":"^PROD-[A-Z0-9_-]{3,30}$"},"planned_quantity":{"type":"integer","minimum":1},"quantity_uom":{"type":"string","enum":["unit","kg","litre","meter"]},"planned_start_time":{"type":"string","format":"date-time"},"planned_end_time":{"type":"string","format":"date-time"},"status":{"type":"string","enum":["CREATED","RELEASED","STARTED","IN_PROGRESS","PAUSED","COMPLETED","CANCELLED"]},"actual_quantity":{"type":"number","minimum":0},"good_quantity":{"type":"number","minimum":0},"rejected_quantity":{"type":"number","minimum":0},"actual_start_time":{"type":["string","null"],"format":"date-time"},"actual_end_time":{"type":["string","null"],"format":"date-time"}},"allOf":[{"if":{"properties":{"status":{"const":"COMPLETED"}}},"then":{"required":["actual_start_time","actual_end_time"]}}],"x-business-rule":"good_quantity + rejected_quantity must not exceed actual_quantity."}